# Neon (Vercel Marketplace)
# Vercel → Storage → Neon kurunca gelen değişkenleri kopyala:
#   POSTGRES_PRISMA_URL        → DATABASE_URL  (pooled / pgbouncer)
#   POSTGRES_URL_NON_POOLING   → DIRECT_URL    (migrate + introspect)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

AUTH_SECRET="replace-with-a-32-character-secret"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
