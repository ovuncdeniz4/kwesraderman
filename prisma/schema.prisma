generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Listing {
  id             String   @id @default(cuid())
  slug           String   @unique
  refNo          Int      @unique
  status         String   @default("draft")
  purpose        String
  category       String   @default("residential")
  type           String
  title          String
  description    String   @default("")
  city           String   @default("İstanbul")
  district       String   @default("")
  neighborhood   String   @default("")
  street         String   @default("")
  complex        String   @default("")
  grossM2        Int?
  netM2          Int?
  rooms          String   @default("")
  bathrooms      Int?
  floor          Int?
  floors         Int?
  parking        Int?
  elevator       Boolean  @default(false)
  amenities      String   @default("[]")
  priceAmount    Int?
  priceCurrency  String   @default("TRY")
  priceOnRequest Boolean  @default(true)
  featured       Boolean  @default(false)
  videoUrl       String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  images         ListingImage[]
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
}

model Inquiry {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String   @default("")
  message   String
  listingId String   @default("")
  createdAt DateTime @default(now())
}
